# Copie para backend/.env

# Etapa 3 da cascata (opcional): modelo multimodal só nos recortes que o hash local não resolveu.
# Sem chave, esses recortes vão direto para a revisão humana.
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5 (com fallback de recusa no servidor). Troque se quiser outro custo/latência.
DECKSCANNER_VLM_MODEL=claude-opus-5
DECKSCANNER_VLM_EFFORT=low
DECKSCANNER_VLM_CONCURRENCY=4

# Verificação geométrica ORB dos candidatos ambíguos (baixa a imagem oficial do candidato, com cache)
DECKSCANNER_ORB_VERIFY=1

# Onde ficam catálogo, banco de hashes, uploads e recortes (padrão: backend/data)
# DECKSCANNER_DATA=D:/deck-scanner-data
# Regras de formato/listas (padrão: backend/rules) — editar não exige reiniciar
# DECKSCANNER_RULES=D:/deck-scanner-rules
