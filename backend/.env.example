# ------------------------------------------------------------------ local (copie para backend/.env)
# Nada é obrigatório: SQLite em backend/data e um usuário único "local".

# Etapa 3 da cascata (opcional): modelo multimodal só nos recortes que o hash local não resolveu.
# Sem chave, esses recortes vão direto para a revisão humana.
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5 (com fallback de recusa no servidor). Troque se quiser outro custo/latência.
DECKSCANNER_VLM_MODEL=claude-opus-5
DECKSCANNER_VLM_EFFORT=low
DECKSCANNER_VLM_CONCURRENCY=4

# Verificação geométrica ORB dos candidatos ambíguos (baixa a imagem oficial do candidato, com cache)
DECKSCANNER_ORB_VERIFY=1

# Onde ficam catálogo, banco de hashes, uploads e recortes (padrão: backend/data)
# DECKSCANNER_DATA=D:/deck-scanner-data
# Regras de formato/listas (padrão: backend/rules) — editar não exige reiniciar
# DECKSCANNER_RULES=D:/deck-scanner-rules

# ------------------------------------------------------------------ hospedado (copie para backend/.env.hosted)
# Vercel + Neon + Cloudflare R2. O banco e o login vêm do `neon link` / `neon config apply` na raiz
# (arquivo .env.local); aqui ficam só o bucket e os opcionais. Depois: `python -m tools.hosted check`, `all` e `vercel-env`.

# Bucket compatível com S3 (Cloudflare R2 → R2 → Manage API tokens → permissão Object Read & Write)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=deck-scanner
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Formas de entrar exibidas no login: password (e-mail e senha) e google
# DECKSCANNER_AUTH_PROVIDERS=password,google
# Leitura por IA na Vercel: ANTHROPIC_API_KEY, AI_GATEWAY_API_KEY ou DECKSCANNER_VLM=1 (token OIDC; gera custo)
